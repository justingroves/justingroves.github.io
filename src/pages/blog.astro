---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
export const blogTitle = "The Unsupervised Learner";
---

<BaseLayout pageTitle={blogTitle}>
  <p>
    Personal blog of Justin Groves - mathematician, data scientist, software
    engineer, and most importantly, Dad.
  </p>
  <div class="flex flex-col gap-6">
    {
      allPosts
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
        .map((post: any) => (
          <BlogPost
            url={`/posts/${post.id}/`}
            title={post.data.title}
            desc={post.data.description}
            pubDate={post.data.pubDate}
            imageURL={post.data.image.url}
            imageAlt={post.data.image.alt}
          />
        ))
    }
  </div>
</BaseLayout>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  pageTitle,
  description = "Senior Data Scientist, PhD mathematician, software developer, and writer.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <!-- Toggle Dark/Light Mode First -->
    <script is:inline>
      (() => {
        const localStorageTheme = localStorage?.getItem("theme") ?? "";

        const dark =
          localStorageTheme === "dark" ||
          (!localStorageTheme &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph elements -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Justin Groves" />

    <!-- Link Tags -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Justin Groves" />
  </head>

  <body class="min-h-screen bg-bg text-text font-sans antialiased">
    <!-- PAGE SHELL -->
    <div class="flex min-h-screen flex-col">
      <Header />

      <!-- MAIN CONTENT -->
      <main class="flex-1">
        <div class="mx-auto max-w-4xl px-6 py-10">
          <h1>{pageTitle}</h1>
          <slot />
        </div>
      </main>

      <Footer />
    </div>

    <script>
      import "../scripts/darkmode.js";
    </script>
  </body>
</html>
